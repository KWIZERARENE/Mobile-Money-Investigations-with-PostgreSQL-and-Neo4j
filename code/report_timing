import csv, statistics as st
R = r"C:\assignement\results"


def pick(cols, *words):
    for w in words:
        for c in cols:
            if w in c.lower():
                return c
    return None


def load(path):
    rd = csv.DictReader(open(path))
    cols = rd.fieldnames
    case = pick(cols, "case")
    ms = pick(cols, "duration_ms", "ms", "duration", "seconds")
    status = pick(cols, "status")
    phase = pick(cols, "phase", "kind", "run")
    print(path, "->", case, ms, status, phase)
    d, bad = {}, {}
    for r in rd:
        if phase and r[phase].lower() in ("warmup", "warm-up", "warm"):
            continue
        if status and r[status].lower() != "ok":
            bad.setdefault(r[case], []).append(r[status])
            continue
        d.setdefault(r[case], []).append(float(r[ms]))
    return d, bad


pg, pgbad = load(rf"{R}\timing_raw_pg.csv")
ne, nebad = load(rf"{R}\timing_raw_neo.csv")
rows = []
for c in pg:
    p = st.median(pg[c])
    n = st.median(ne[c]) if ne.get(c) else None
    rows.append([c, round(p, 1), round(min(pg[c]), 1), round(max(pg[c]), 1),
                 n and round(n, 1), n and round(min(ne[c]), 1), n and round(max(ne[c]), 1),
                 n and round(p / n, 3)])
with open(rf"{R}\timing_summary.csv", "w", newline="") as f:
    w = csv.writer(f)
    w.writerow(["case", "pg_med_ms", "pg_min", "pg_max", "neo_med_ms", "neo_min", "neo_max", "pg_over_neo"])
    w.writerows(rows)
for r in rows:
    print(r)
print("errors/timeouts PG:", pgbad, "Neo:", nebad)